# Local development only. Copy to .env if you need overrides.
# Never place real bank credentials or production secrets here.
# Copy this file to backend/.env when overriding local defaults.
AEGIS_DATABASE_PATH=data/aegisbank.db
AEGIS_DEMO_OTP=246810
AEGIS_CONFIRMATION_TTL_SECONDS=300
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Structured planner: rule | llm | auto
AEGIS_PLANNER_MODE=rule
AEGIS_LLM_BASE_URL=
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=
AEGIS_LLM_TIMEOUT_SECONDS=20
